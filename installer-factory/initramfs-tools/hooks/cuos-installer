#!/bin/sh

case "${1:-}" in
  prereqs) echo ""; exit 0;;
esac

[ -r /usr/share/initramfs-tools/hook-functions ] || exit 0
# shellcheck source=/dev/null
. /usr/share/initramfs-tools/hook-functions

copy_exec /usr/bin/dialog
copy_exec /usr/bin/lsblk
copy_exec /usr/bin/pv
copy_exec /bin/gzip || true
copy_exec /usr/bin/zstd

mkdir -p "$DESTDIR/usr/share/terminfo/l/"
cp -p /usr/share/terminfo/l/linux "$DESTDIR/usr/share/terminfo/l/linux"
