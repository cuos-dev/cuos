#!/bin/sh

case "$1" in
  prereqs)
    echo ""
    exit 0
  ;;
esac

set -x

# shellcheck source=/dev/null
. /scripts/functions

iso_label="CUOS"
image="/image.img"
mount_point="/cdrom"

log() { echo "iso-img: $*" >&2; }
raise() {
  sleep 5
  dialog --clear --backtitle "Installer" \
    --title "Error" \
    --msgbox "$*" 10 40 >&2
  echo "iso-img: $*" >&2

  sh
  reboot -f
}

find_dev_by_label() {
  blkid -o device -t "LABEL=$iso_label" 2>/dev/null | head -n1 || true
}
detect_fstype() {
  dev="$1"
  blkid -o value -s TYPE "$dev" 2>/dev/null || true
}
try_mount() {
  t="$1"
  shift
  mount -t "$t" -o ro "$@"
}

mount_iso() {
  l_iso_dev="${1:-}"
  l_mount_point="${2:-}"

  mkdir -p "$l_mount_point"

  fstype="$(detect_fstype "$l_iso_dev")"

  # Main mounting logic
  if [ "$fstype" = "iso9660" ] || [ "$fstype" = "udf" ]; then
    if ! try_mount "$fstype" "$l_iso_dev" "$l_mount_point"; then
      log "WARN: $fstype mount failed on $l_iso_dev, will try fallbacks"
    else
      return 0
    fi
  elif [ "$fstype" = "hfsplus" ]; then
    modprobe nls_utf8 2>/dev/null || true
    modprobe hfsplus 2>/dev/null || true

    # Read-only is fine for journaled HFS+
    if ! try_mount "hfsplus" "$l_iso_dev" "$l_mount_point"; then
      log "WARN: hfsplus mount failed on $l_iso_dev, will try fallbacks"
    else
      return 0
    fi
  fi

  # Fallback sequence if detection was missing or failed
  if try_mount "iso9660" "$l_iso_dev" "$l_mount_point"; then
    return 0
  fi
  if try_mount "udf" "$l_iso_dev" "$l_mount_point"; then
    return 0
  fi
  modprobe nls_utf8 2>/dev/null || true
  modprobe hfsplus 2>/dev/null || true
  if try_mount "hfsplus" "$l_iso_dev" "$l_mount_point"; then
    return 0
  fi

  raise "ERROR: mount failed for all known types (iso9660/udf/hfsplus): $l_iso_dev"
}

find_dev() {
  wait_for_udev 10
  sleep 5

  l_iso_dev="$(find_dev_by_label)"

  if [ -z "${l_iso_dev:-}" ] && [ -b "/dev/sr0" ]; then
    l_iso_dev="/dev/sr0"
  fi
  if [ -z "${l_iso_dev:-}" ]; then
    l_iso_dev="$(blkid -t TYPE=iso9660 -o device 2>/dev/null | head -n1 || true)"
  fi
  if [ -z "${l_iso_dev:-}" ]; then
    l_iso_dev="$(blkid -t TYPE=udf -o device 2>/dev/null | head -n1 || true)"
  fi
  if [ -z "${l_iso_dev:-}" ]; then
    l_iso_dev="$(blkid -t TYPE=hfsplus -o device 2>/dev/null | head -n1 || true)"
  fi

  echo "$l_iso_dev"
}

extract_image() {
  image_path="$1"
  target="$2"
  # Use a named pipe so dialog reads progress separately from the decompression pipeline.
  PROG_FIFO="/tmp/imgprog.$$"
  mkfifo "$PROG_FIFO" || return 1
  # ensure fifo is removed on function exit
  _cleanup() {
    rm -f "$PROG_FIFO" 2>/dev/null || true
  }
  trap _cleanup EXIT

  # Start dialog reading progress from the fifo in the background
  dialog --gauge "Preparing to extract image, please wait..." 10 70 0 <"$PROG_FIFO" &
  DIALOG_PID=$!

  # Run the actual decompression/writing pipeline; pv will write numeric progress to stderr,
  # which we redirect into the fifo so dialog displays it. Capture the pipeline exit code.
  if echo "$image_path" | grep -qE '\.zst$'; then
    pv -n "$image_path" 2>"$PROG_FIFO" | zstd -d -c | dd of="/dev/$target" bs=4M conv=notrunc,noerror
    RC=$?
  elif echo "$image_path" | grep -qE '\.gz$'; then
    pv -n "$image_path" 2>"$PROG_FIFO" | gunzip -c | dd of="/dev/$target" bs=4M conv=notrunc,noerror
    RC=$?
  else
    pv -n "$image_path" 2>"$PROG_FIFO" | dd of="/dev/$target" bs=4M conv=notrunc,noerror
    RC=$?
  fi

  # Wait for dialog to finish reading remaining input and exit
  wait "$DIALOG_PID" 2>/dev/null || true

  # Cleanup and return the pipeline's exit code
  trap - EXIT
  _cleanup
  return "$RC"
}

main() {

  iso_dev="$(find_dev)"
  if [ -z "${iso_dev:-}" ]; then
    raise "ERROR: Could not locate ISO device (label=$iso_label)"
  fi

  mount_iso "${iso_dev}" "${mount_point}"

  # Lower kernel console loglevel temporarily, so dialogs are not destroyed.
  echo 1 > /proc/sys/kernel/printk

  # Loop-mount the embedded image (read-only by default)
  # Support either uncompressed image or a gzipped image on the ISO
  if [ -e "$mount_point$image" ]; then
    image_path="$mount_point$image"
  elif [ -e "$mount_point${image}.zst" ]; then
    image_path="$mount_point${image}.zst"
  elif [ -e "$mount_point${image}.gz" ]; then
    image_path="$mount_point${image}.gz"
  else
    raise "WARN: $mount_point$image or ${image}.zst/gz not found"
  fi

  echo "Running custom installer..."

  # Collect disks: TYPE=disk, RO=0
  DISKS=""
  while read -r name type ro size model; do
    [ "$type" = "disk" ] || continue
    [ "$ro" = "0" ] || continue
    # Filter out iso_dev
    if [ "/dev/$name" = "$iso_dev" ]; then
      continue
    fi
    safe_model=$(echo "$model" | tr ' ' '_')
    label="${size}_${safe_model}"
    DISKS="$DISKS $name $label off"
  done <<INNEREOF
$(lsblk -dn -o NAME,TYPE,RO,SIZE,MODEL)
INNEREOF

  COUNT=$(echo "$DISKS" | wc -w)
  # Each disk adds 3 words (name label off), so count/3
  COUNT=$((COUNT / 3))

  if [ "$COUNT" -eq 0 ]; then
    raise "No writable disks found"
  fi
  if [ "$COUNT" -eq 1 ]; then
    # select it automatically, it replace off by on
    DISKS=$(echo "$DISKS" | sed 's/ off$/ on/')
  fi

  if [ "$COUNT" -eq 1 ] && [ -f "$mount_point/installer_auto_overwrite_disk.txt" ]; then
    target=$(echo "$DISKS" | awk '{print $1}')
  else
    # shellcheck disable=SC2086
    target=$(dialog --clear --backtitle "Installer" \
      --title "Select Target Disk. The disk will be OVERWRITTEN." \
      --no-cancel \
      --radiolist "\nUse up/down keys, select with space key and hit enter:\n " 15 70 5 \
      $DISKS 3>&1 1>&2 2>&3)
    clear
  fi

  if [ -z "$target" ]; then
    raise "No disk selected"
  fi

  echo "$target"


  echo "Writing $(basename "$image_path") to /dev/$target... (this may take a while)"
  if ! extract_image "$image_path" "$target"; then
    raise "Failed writing image to disk"
  fi

  sync
  dialog --backtitle "Installer" --title "Image sucessfully written to disk" --infobox "\nThe system will reboot now.\n\nEnsure to boot from the selected disk." 10 70
  sleep 1
  #sh
  reboot -f
}

main

